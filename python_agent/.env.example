# GeologyGPT Python Agent — Environment Variables
# cp .env.example .env  then fill in your keys

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=geologygpt

# Optional — web search (free tier: 1000/month). Agent works without it.
TAVILY_API_KEY=your_tavily_api_key_here

PYTHON_AGENT_PORT=8000

# Set to your Node.js server URL (for CORS on Render)
# Example: https://geologygpt-server.onrender.com
NODE_SERVER_URL=http://localhost:5000
