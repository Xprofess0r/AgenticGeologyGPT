# GeologyGPT Node.js Server — Environment Variables

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Pinecone (used by Node upload pipeline)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=geologygpt

# Tavily (optional)
TAVILY_API_KEY=your_tavily_api_key_here

# Python agent URL
# LOCAL:  http://localhost:8000
# RENDER: https://your-python-agent.onrender.com
PYTHON_AGENT_URL=http://localhost:8000

# Client URL (for CORS)
# LOCAL:  http://localhost:3000
# DEPLOY: https://your-app.vercel.app
CLIENT_URL=http://localhost:3000

PORT=5000
NODE_ENV=development

# Set to false to disable Node.js fallback (use Python agent only)
ENABLE_NODEJS_FALLBACK=true
